# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---- uv ----
# Keep uv.lock committed. Do not ignore it.

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Testing / tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Data (rebuilt by pipelines/download.py) ----
# Raw is never committed; processed is regenerable.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/app/
*.parquet

# ---- MLflow / model artifacts ----
# MLflow 3 metadata + GenAI traces (SQLite) live under data/mlflow/.
# Artifacts are not logged; root mlruns/ is kept ignored for legacy stores.
data/mlflow/
/mlflow.db
/mlflow.db-shm
/mlflow.db-wal
mlruns/
mlartifacts/
# Root-only: the registered joblib artifacts. Without the leading slash this
# also swallowed apps/api/app/models/ (the SQLAlchemy package).
/models/

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride

# ---- IDE ----
.idea/
.vscode/
*.swp

# ---- Node / frontend (apps/web) ----
node_modules/
coverage/
*.tsbuildinfo
.eslintcache
