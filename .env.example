# UpliftIQ copilot credentials — variable NAMES are committed, values never are.
# Copy to .env and fill in. Nothing here is read by tests; the live smoke tests
# skip themselves when these are absent. See docs/concepts.md §7.

# --- Decisions API (the gate/router; shape from research/notebooks/decision_api.ipynb) ---
AZURE_ENDPOINT=https://your-resource-host
AZURE_API_KEY=your-decisions-api-key
AZURE_DEPLOYMENT_NAME=your-decisions-model-name

# --- NEUROMETRIC gateway (OpenAI-compatible /chat/completions; generative writer) ---
NEUROMETRIC_BASE_URL=https://your-gateway-host/v1
NEUROMETRIC_API=your-neurometric-key

# --- Ollama (OpenAI-compatible writer; optional override) ---
# Defaults to http://localhost:11434 (configs/copilot.yaml -> writer.ollama_base_url).
# OLLAMA_BASE_URL=http://localhost:11434
